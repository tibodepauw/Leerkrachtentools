# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/avatars/
/data/zill/
/data/go/
/data/ovsg/
/data/minimumdoelen/
/data/opstap/
/data/go_nieuw/
/data/secundair/
/data/okan/
