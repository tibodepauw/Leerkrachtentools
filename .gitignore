# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.tooling/
/test-leerkrachtentools.db*
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/avatars/

# Raw, scraped and converted curriculum corpora (never public git)
data/**/*.jsonl
data/**/*.pdf
data/**/*.json
data/okan/
data/bubao/
data/buso/
data/dko/
data/secundair/
data/basisonderwijs/
/data/zill/
/data/go/
/data/ovsg/
/data/minimumdoelen/
/data/opstap/
/data/go_nieuw/
/data/volwassenen/
/data/hoger/
/dist/secundair_update.zip

# Templates may be committed; un-ignore after the corpus globs
!data/templates/**
!data/templates/.gitkeep

# Small CI fixtures only; full secundair dumps stay out of git
!test/fixtures/**
test/fixtures/curriculum-secundair.jsonl
test/fixtures/minimumdoelen-secundair.jsonl
test/fixtures/curriculum-pov-secundair.jsonl
test/fixtures/*.docx
test/fixtures/*.pdf
!test/fixtures/.gitkeep

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]
*.zip
tmp_*
curriculum_*.zip

# AI agent instruction files (local only, never GitHub)
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules
.cursor/rules/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
