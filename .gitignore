test/fixtures/minimumdoelen-secundair.jsonl
test/fixtures/curriculum-pov-secundair.jsonl

# Sjablonen en documenten
data/templates/*.docx
data/templates/*.pdf
!data/templates/.gitkeep
test/fixtures/*.docx
test/fixtures/*.pdf
!test/fixtures/.gitkeep

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]
*.zip
tmp_*
curriculum_*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
