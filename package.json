{
  "name": "leerkrachtentools",
  "version": "5.21.0-rc.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/apply-braces-security-patch.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rag-benchmark": "vitest run test/rag-benchmark.test.ts lib/rag/ragBenchmark.test.ts",
    "manage-api-keys": "tsx --require ./scripts/allow-server-only.cjs scripts/manage-api-keys.ts",
    "migrate:quota-ledgers": "tsx --require ./scripts/allow-server-only.cjs scripts/migrate-quota-ledgers.ts",
    "corpus:setup": "node scripts/corpus.mjs setup",
    "corpus:verify": "node scripts/corpus.mjs --verify",
    "corpus:export": "node scripts/corpus.mjs --export",
    "import:ovsg-export": "node scripts/corpus.mjs import-ovsg-export",
    "fetch:ovsg": "node scripts/corpus.mjs fetch-ovsg",
    "fetch:ovsg-secundair": "node scripts/corpus.mjs fetch-ovsg-secundair",
    "fetch:secundair": "node scripts/corpus.mjs --datasets SECUNDAIR_LEERPLANNEN SECUNDAIR_MINIMUMDOELEN POV",
    "fetch:all": "node scripts/corpus.mjs",
    "fetch:domains": "node scripts/corpus.mjs --domains-only",
    "export:secundair": "python3 scripts/export_secundair_zip.py",
    "export:banner": "node scripts/export-banner-prod.mjs",
    "export:banner:dev": "node scripts/export-banner-assets.mjs",
    "export:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "security:audit": "node scripts/audit-production-dependencies.mjs",
    "check:corpora": "tsx scripts/check-corpora.ts",
    "build:workers": "node scripts/build-workers.mjs",
    "prebuild": "npm run build:workers",
    "pretest": "npm run build:workers",
    "predev": "npm run build:workers"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.49",
    "@ai-sdk/google": "^4.0.72",
    "@ai-sdk/groq": "^4.0.42",
    "@ai-sdk/openai": "^4.0.67",
    "@google-cloud/discoveryengine": "^2.9.0",
    "ai": "^7.0.102",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "input-otp": "^1.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.12.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "posthog-js": "^1.433.5",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acorn": "8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "qs": "6.17.1",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "undici": "7.30.2",
    "@grpc/grpc-js": "1.14.5",
    "dompurify": "3.4.17",
    "hono": "4.13.12",
    "@hono/node-server": "2.1.3",
    "glob": "14.0.4",
    "minimatch@10": "11.0.7"
  }
}
