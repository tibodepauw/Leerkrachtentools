[Unit]
Description=Leerkrachtentools
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=leerkrachtentools
Group=leerkrachtentools
WorkingDirectory=/opt/leerkrachtentools/current
EnvironmentFile=/etc/leerkrachtentools/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leerkrachtentools
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
TasksMax=128
MemoryHigh=1500M
MemoryMax=2G
MemorySwapMax=0
CPUQuota=150%
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
