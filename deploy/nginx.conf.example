# Put limit zones in the http {} context. Replace tools.example.be and TLS paths.
# Trust boundary: nginx is the only public listener and Node listens on 127.0.0.1.
# Every location overwrites the client-IP headers with $remote_addr and clears the
# ones it does not manage; only then may the app run with TRUST_PROXY_IP_HEADERS=true.
# Keep these proxy_set_header lines identical in every location that proxies to Node.
# If another proxy or CDN sits in front of nginx, $remote_addr is that proxy: configure
# the realip module for its addresses first, or every visitor shares one limit.
limit_req_zone $binary_remote_addr zone=lt_requests:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=lt_login:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=lt_connections:10m;
limit_conn_zone $server_name zone=lt_global_connections:1m;

server {
    listen 80;
    server_name tools.example.be;
    return 301 https://tools.example.be$request_uri;
}

server {
    listen 443 ssl;
    server_name tools.example.be;
    ssl_certificate /etc/letsencrypt/live/tools.example.be/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tools.example.be/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 12m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    send_timeout 30s;
    keepalive_timeout 30s;
    limit_conn lt_connections 20;
    limit_conn lt_global_connections 100;
    limit_req_status 429;
    limit_conn_status 429;

    location / {
        limit_req zone=lt_requests burst=40 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Vercel-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
        proxy_request_buffering on;
    }

    # Both login steps share the lt_login zone: requesting and guessing codes
    # draw from one per-IP allowance.
    location ~ ^/api/auth/(request-code|verify-code)$ {
        limit_req zone=lt_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Vercel-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 15s;
        proxy_request_buffering on;
    }
}
