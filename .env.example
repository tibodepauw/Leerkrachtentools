# Voeg alleen de providers toe die je wilt gebruiken. Zonder keys gebruikt de
# applicatie deterministische lokale demo-antwoorden waar van toepassing.
# Google AI Studio (aanbevolen voor doelverbeteraar & taxonomie)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optioneel: officiële Onderwijsdoelen-API voor corpusupdates.
ONDERWIJSDOELEN_API_KEY=

# OVSG Leer Lokaal (HTTP Basic Auth) — alleen voor scripts/scrape_ovsg_full.py
OVSG_LEERLOKAAL_USER=
OVSG_LEERLOKAAL_PASSWORD=

# E-mailverificatie (Brevo) en lokale SQLite-opslag
BREVO_API_KEY=
BREVO_FROM_EMAIL=Leerkrachtentools <login@jouwdomein.be>
FEEDBACK_TO_EMAIL=tibo.depauw06@gmail.com
AUTH_SECRET=
DATABASE_PATH=./data/leerkrachtentools.db

# Optioneel: overschrijf repo-link in instellingen (anders uit git remote)
# NEXT_PUBLIC_GITHUB_REPO=https://github.com/tibodepauw/Leerkrachtentools

# Google Cloud Discovery Engine (curriculum RAG)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION="global"
GOOGLE_DATA_STORE_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
