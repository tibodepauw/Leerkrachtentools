# AI providers (configure one or more; users can also add their own key in Settings)
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
# Multimodal-compatible provider (manual scanner, voice reflection)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# Optional: official Onderwijsdoelen API for corpus update scripts only (never commit the key)
ONDERWIJSDOELEN_API_KEY=

# Optional: Provinciaal Onderwijs Vlaanderen Doelenverdeler API
POV_API_KEY=

# OVSG Leer Lokaal credentials for scripts/scrape_ovsg_full.py only
OVSG_LEERLOKAAL_USER=
OVSG_LEERLOKAAL_PASSWORD=

# Email login (Brevo) and local SQLite storage
BREVO_API_KEY=
BREVO_FROM_EMAIL=Leerkrachtentools <login@yourdomain.be>
FEEDBACK_TO_EMAIL=feedback@yourdomain.be
AUTH_SECRET=
API_KEY_ENCRYPTION_SECRET=
# During a controlled key rotation only; comma-separated previous secrets
API_KEY_ENCRYPTION_PREVIOUS_SECRETS=
DATABASE_PATH=./data/leerkrachtentools.db

# Canonical production origin used for CSRF validation
APP_ORIGIN=https://tools.example.be
# Enable only when your reverse proxy strips and rewrites forwarded IP headers
TRUST_PROXY_IP_HEADERS=false
# Localhost-only development convenience; never enable in production or previews
ALLOW_DEV_LOGIN_CODE=false

# Account tiers (comma-separated e-mails, checked on each login/session; required for admin access)
# Unknown addresses cannot request a code or open the app.
ADMIN_EMAILS=
TESTER_EMAILS=
PARTNER_EMAILS=

# Module visibility (server-side; restart required after changes)
# Hide modules for everyone (comma-separated module ids)
# HIDDEN_MODULES=voice-reflection,engagement
# Hide modules for one tier only
# HIDDEN_MODULES_STUDENT=
# HIDDEN_MODULES_PARTNER=
# HIDDEN_MODULES_TESTER=
# HIDDEN_MODULES_ADMIN=
# Per-user hide: email:module1,module2;other@school.be:module3
# USER_MODULE_DENIALS=jan@school.be:full-audit,voice-reflection
# Per-user grant (beta access beyond tier defaults)
# USER_MODULE_GRANTS=beta@school.be:voice-reflection,engagement

# Optional: repo link in Settings (otherwise derived from git remote)
# NEXT_PUBLIC_GITHUB_REPO=https://github.com/tibodepauw/Leerkrachtentools

# Optional build metadata (usually set by CI)
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_APP_COMMIT=
